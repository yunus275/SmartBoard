{
  "name": "aymen-schoolboard",
  "version": "1.1.0",
  "description": "Aymen Schoolboard",
  "main": "src/electron/main.js",
  "author": "Aymen",
  "license": "UNLICENSED",
  "scripts": {
    "build": "node scripts/build.js",
    "start": "npm run build && electron .",
    "dist": "npm run build && electron-builder --win portable"
  },
  "dependencies": { "pdfjs-dist": "3.11.174" },
  "devDependencies": { "electron": "^31.0.0", "electron-builder": "^24.13.3" },
  "build": {
    "appId": "com.aymen.schoolboard",
    "productName": "Aymen Schoolboard",
    "directories": { "output": "release" },
    "files": ["dist/**/*", "src/electron/**/*", "public/icon.png"],
    "win": { "target": ["portable"], "icon": "public/icon.png" },
    "portable": { "artifactName": "Aymen-Schoolboard.exe" }
  }
}
